{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "BX-HOST/0.1-draft1"
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "epoch": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "blockId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "incarnation": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "bindingRevision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "stateRevision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "viewportRevision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "themeRevision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "frameSequence": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        }
      },
      "required": [
        "session",
        "epoch",
        "blockId",
        "incarnation",
        "sourceRevision",
        "bindingRevision",
        "stateRevision",
        "viewportRevision",
        "themeRevision",
        "frameSequence"
      ]
    },
    "widgetId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "bindingId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "contextRevision": {
      "type": "string",
      "maxLength": 4096
    },
    "eventId": {
      "type": "string",
      "maxLength": 4096
    },
    "commandId": {
      "type": "string",
      "maxLength": 4096
    },
    "action": {
      "enum": [
        "activate",
        "commit"
      ]
    },
    "expectedValueRevision": {
      "type": "string",
      "maxLength": 4096
    },
    "value": {
      "type": [
        "string",
        "number",
        "boolean"
      ]
    }
  },
  "required": [
    "contract",
    "key",
    "widgetId",
    "bindingId",
    "contextRevision",
    "eventId",
    "commandId",
    "action"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "commit"
          }
        }
      },
      "then": {
        "required": [
          "expectedValueRevision",
          "value"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "expectedValueRevision"
              ]
            },
            {
              "required": [
                "value"
              ]
            }
          ]
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
